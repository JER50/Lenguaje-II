	<classpathentry kind="src" path="archivos"/>
	<classpathentry kind="lib" path="lib/commons-logging-1.2.jar"/>
	<classpathentry kind="lib" path="lib/flatlaf-3.7.2.jar"/>
	<classpathentry kind="lib" path="lib/jxmapviewer2-2.8.jar"/>
	<classpathentry kind="lib" path="lib/gson-2.15.0.jar"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
